#!/bin/sh
# 담당: 민규. 각 복제본에서 설정한 작업자 기준으로 staged 파일만 검사합니다.
set -eu
repo_root=$(git rev-parse --show-toplevel)
actor=$(git config --local --get yumidang.actor || true)
case "$actor" in
  minkyu|jonghyun|yumi) ;;
  *)
    echo '현재 작업자 설정 필요: minkyu 또는 jonghyun 또는 yumi. 본인 별도 clone에서 setup_actor.py를 사용하세요.' >&2
    exit 1
    ;;
esac
exec python3 "$repo_root/tools/collaboration/check_ownership.py" --actor "$actor" --staged
