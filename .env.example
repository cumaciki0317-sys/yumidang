# GEMINI_API_KEY: Required only for optional Gemini AI API experiments.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL used for links and callbacks when deployed.
APP_URL="MY_APP_URL"

# Supabase browser client. Use only the project URL and a publishable key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Enable only after test-phone-auth is deployed and its server-side test gate is enabled.
VITE_TEST_PHONE_AUTH="false"

# 네이버 가입·로그인 서버 전용. 실제 값은 로컬 .env 또는 배포 Secrets에만 입력한다.
# redirect URI는 프론트 콜백 URL이며 ALLOWED_ORIGINS에 해당 origin이 있어야 한다.
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
NAVER_REDIRECT_URI=""
# 1..3600초 기술 범위. 실제 운영 TTL은 팀이 정하며 코드 기본값은 없다.
NAVER_STATE_TTL_SECONDS=""

# 공통 서버 설정. 서버 키·내부 secret은 브라우저용 변수에 넣지 않는다.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
INTERNAL_WORKER_SECRET=""
ALLOWED_ORIGINS=""
# service-api는 신고 상세 4000자·JSON 이스케이프 수용을 위해 65536바이트 이상이 필요하다.
MAX_REQUEST_BYTES="65536"
UPSTREAM_TIMEOUT_MS=""

# 모델·보관 검토·추가 지출 근거·예산 원장. 실제 회원 원문 전송 승인은 별도다.
POTENS_API_KEY=""
# 다중 계정 모드는 ORDER로 명시 선택한다. 선택 계정의 키가 모두 필요하며 오류 때 단일키로 대체하지 않는다.
# 등록된 계정을 유미→종현→민규→성호 순으로 입력한다. 새 항목이 모두 비면 기존 단일키 경로 유지.
POTENS_ACCOUNT_ORDER=""
POTENS_API_KEY_YUMI=""
POTENS_API_KEY_JONGHYUN=""
POTENS_API_KEY_MINKYU=""
POTENS_API_KEY_SUNGHO=""
# 활성 다중 설정에는 확정값3200000과 Asia/Seoul을 명시한다. 전체 상한은 등록 계정 합계다.
# 설정만으로 운영 호출이 활성화되지 않는다. 원자 원장·개인정보/출력 조건 검증은 별도다.
POTENS_ACCOUNT_TOKEN_BUDGET=""
POTENS_RESET_TIMEZONE=""
POTENS_API_BASE_URL=""
POTENS_MODEL=""
AI_RETENTION_DECISION_ID=""
AI_COST_EVIDENCE_ID=""
AI_BUDGET_LEDGER_ID=""
POTENS_USAGE_INPUT_FIELD=""
POTENS_USAGE_OUTPUT_FIELD=""

# AI 탐색 한도. 운영 수치는 팀 검토이며 기본값을 넣지 않는다.
AI_CHAT_MAX_MESSAGES=""
AI_CHAT_MAX_MESSAGE_CHARS=""
AI_CHAT_MAX_TOTAL_CHARS=""
AI_CHAT_MAX_OUTPUT_TOKENS=""
AI_CHAT_SEARCH_PAGE_SIZE=""
AI_CHAT_MAX_SEARCH_PAGES=""
AI_CHAT_RECHECK_MAX_PAGES=""
AI_CHAT_MAX_RESULT_CARDS=""
AI_CHAT_MATCH_BATCH_SIZE=""
AI_CHAT_MAX_MATCH_CALLS=""
AI_CHAT_MATCH_MAX_OUTPUT_TOKENS=""

# 후기 요약 worker. 승인된 안전 검사기가 없으면 작업을 점유하지 않는다.
REVIEW_SUMMARY_MODEL_VERSION=""
REVIEW_SUMMARY_PROMPT_VERSION=""
REVIEW_SUMMARY_WORKER_MAX_JOBS_PER_RUN=""
REVIEW_SUMMARY_WORKER_TIME_BUDGET_MS=""
REVIEW_SUMMARY_LEASE_SECONDS=""
REVIEW_SUMMARY_RETRY_MAX_ATTEMPTS=""
REVIEW_SUMMARY_RETRY_BASE_DELAY_MS=""
REVIEW_SUMMARY_RETRY_MAX_DELAY_MS=""
REVIEW_SUMMARY_BUDGET_DEFER_MS=""
REVIEW_SUMMARY_MAX_INPUT_CHARS=""
REVIEW_SUMMARY_MAX_REVIEWS_PER_CHUNK=""
REVIEW_SUMMARY_MERGE_FAN_IN=""
REVIEW_SUMMARY_MAX_OUTPUT_TOKENS=""
REVIEW_SUMMARY_MAX_OUTPUT_CHARS=""
REVIEW_SUMMARY_MAX_CALLS_PER_STEP=""

# 장소·행사 제공처와 수집. Seoul 연결은 팀 검토이며 자동 활성화하지 않는다.
KAKAO_REST_API_KEY=""
KOPIS_API_KEY=""
TOUR_API_SERVICE_KEY=""
TOUR_API_KEY_FORMAT=""
PLACES_PAGE_SIZE=""
EVENT_SYNC_PROVIDERS=""
EVENT_SYNC_MAX_PERIOD_DAYS=""
EVENT_SYNC_MAX_PAGE=""
EVENT_SYNC_PAGE_ROWS=""

# 매일 00:01 Asia/Seoul 실행 정책. 등록·운영 한도는 별도 설정 작업이다.
EVENT_SYNC_DAILY_PROVIDERS=""
EVENT_SYNC_DAILY_TIME_ZONE=""
EVENT_SYNC_DAILY_WINDOW_DAYS=""
EVENT_SYNC_DAILY_MAX_PAGES=""
EVENT_SYNC_DAILY_TIMEOUT_MS=""
DAILY_SUMMARY_WORKER_MAX_INVOCATIONS=""
DAILY_SUMMARY_WORKER_TIMEOUT_MS=""
