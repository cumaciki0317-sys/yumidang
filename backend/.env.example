# 유미당 서버 API 입력 양식
# 실제 값은 현재 열어둔 yumidang/.env에만 입력하세요. 이 example은 빈 상태로 공유합니다.
# 서버 설정 loader와 오프라인 검사는 구현했습니다. 공급사 런타임 연결은 별도입니다.
# 발급받은 항목만 따옴표 안에 입력하고 나머지는 빈칸으로 둡니다.
# URL에는 키를 붙이지 않습니다. 전체 안내: backend/API_INPUT.md

# [장소 검색 / 종현 연결 담당]
KAKAO_REST_API_KEY=""

# [공연·행사 / 종현 연결 담당]
KOPIS_API_KEY=""
SEOUL_OPEN_DATA_API_KEY=""
TOUR_API_SERVICE_KEY=""
# 받은 키의 표시 형태를 기록: decoded 또는 encoded. 원문을 임의 변환하지 않습니다.
TOUR_API_KEY_FORMAT=""


# [포텐스닷 LLM / 종현 연결 담당]
# POTENS는 이 프로젝트의 수집용 이름이며 공급사의 공식 환경변수명이 아닙니다.
POTENS_API_KEY=""
POTENS_API_BASE_URL="https://ai.potens.ai"
POTENS_API_DOCS_URL=""
POTENS_API_PURPOSE="LLM"
# 사용자 확인: Sonnet 5 유지. 캡처의 claude-4-6-sonnet으로 자동 변경하지 않습니다.
# 포텐스닷 공개 채팅 모델 목록에서 확인한 ID입니다. 코드 프록시 ID와 다릅니다.
POTENS_REQUESTED_MODEL="Sonnet 5"
POTENS_MODEL="claude-5-sonnet"

# 요청 제한시간(ms), 기술 설정. 실제 호출부에서 적용합니다.
UPSTREAM_TIMEOUT_MS="10000"

# [AI / 종현 연결 담당 — 공급사·모델 선택은 별도]
AI_PROVIDER=""
AI_MODEL=""
AI_API_KEY=""
# Gemini로 발급받은 키가 있는 경우 위 AI_API_KEY 대신 이 항목에 입력합니다.
GEMINI_API_KEY=""

# [PASS / 민규 연결 담당 — 발급 안내에 있는 항목만 입력]
IDENTITY_PROVIDER=""
IDENTITY_API_BASE_URL=""
IDENTITY_CLIENT_ID=""
IDENTITY_CLIENT_SECRET=""
IDENTITY_API_KEY=""

# [문자 / 민규 연결 담당]
SMS_PROVIDER=""
SMS_API_BASE_URL=""
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_NUMBER=""

# [계좌 인증 / 민규 연결 담당]
BANK_PROVIDER=""
BANK_API_BASE_URL=""
BANK_CLIENT_ID=""
BANK_CLIENT_SECRET=""
BANK_API_KEY=""

# [추가로 수집한 API — 필요하면 OTHER_API_2_...처럼 복사]
OTHER_API_1_NAME=""
OTHER_API_1_PURPOSE=""
OTHER_API_1_BASE_URL=""
OTHER_API_1_DOCS_URL=""
OTHER_API_1_KEY=""
OTHER_API_1_SECRET=""
