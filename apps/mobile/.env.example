# 공개 가능한 설정만 사용합니다. 비밀키·DB 주소·서비스 역할 키·회원 토큰을 넣지 마세요.
# preview는 로컬 예시, service는 아래 HTTPS API를 읽습니다. 실제 인증/서버 계약은 별도 연결합니다.
EXPO_PUBLIC_DATA_MODE=preview
EXPO_PUBLIC_SERVICE_API_URL=
EXPO_PUBLIC_AI_CHAT_URL=
EXPO_PUBLIC_PRIVACY_URL=
# 서버 검사 활성 환경은 required. 미설정/legacy는 기존 비활성 서버용이며
# 직접 입력/행사 변경은 그 경우에도 검사를 생략하지 않습니다. 서버 설정을 변경하는 값이 아닙니다.
EXPO_PUBLIC_POST_CONTENT_INSPECTION=
